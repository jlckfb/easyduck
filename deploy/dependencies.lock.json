      "web/requirements.lock",
      "calibration/requirements.lock"
    ],
    "system_components": [
      "systemd and systemd-sysusers",
      "ALSA utilities: aplay and amixer",
      "libudev runtime",
      "BlueZ and Linux input subsystem"
